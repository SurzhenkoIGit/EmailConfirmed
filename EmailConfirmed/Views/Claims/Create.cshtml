@{
    ViewData["Title"] = "Create Claim";
}

<div class="container mx-auto px-4 py-8">
    <div class="max-w-2xl mx-auto">
        <h1 class="text-3xl font-bold mb-6 text-gray-800">Создать утверждение</h1>

        <div class="bg-white rounded-lg shadow-lg p-6">
            <div asp-validation-summary="All" class="mb-6 text-sm text-red-600"></div>

            <form method="post" class="space-y-6">
                <!-- Тип -->
                <div>
                    <label for="ClaimType" class="block text-sm font-medium text-gray-700 mb-1">
                        Тип
                    </label>
                    <input name="ClaimType"
                           class="appearance-none block w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm focus:outline-none focus:ring-green-500 focus:border-green-500 sm:text-sm" />
                </div>

                <!-- Значение -->
                <div>
                    <label for="ClaimValue" class="block text-sm font-medium text-gray-700 mb-1">
                        Значение
                    </label>
                    <input name="ClaimValue"
                           class="appearance-none block w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm focus:outline-none focus:ring-green-500 focus:border-green-500 sm:text-sm" />
                </div>

                <!-- Кнопки -->
                <div class="flex items-center space-x-4 pt-4">
                    <button type="submit"
                            class="inline-flex items-center px-4 py-2 bg-green-600 hover:bg-green-700 text-white font-medium rounded-md transition-colors duration-300">
                        <i class="fas fa-save mr-2"></i>
                        Создать
                    </button>
                    <a asp-action="Index"
                       class="inline-flex items-center px-4 py-2 bg-gray-600 hover:bg-gray-700 text-white font-medium rounded-md transition-colors duration-300">
                        <i class="fas fa-arrow-left mr-2"></i>
                        Назад
                    </a>
                </div>
            </form>
        </div>
    </div>
</div>