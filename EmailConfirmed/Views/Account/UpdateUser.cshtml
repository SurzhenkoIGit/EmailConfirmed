@model EmailConfirmed.Models.User

@{
    ViewData["Title"] = "Update user";
}

<div class="container mx-auto px-4 py-8 max-w-4xl">
    <div class="bg-white rounded-lg shadow-md p-6">
        <div class="mb-6 text-center">
            <h1 class="text-2xl font-bold text-gray-800">Обновление настроек аккаунта</h1>
        </div>

        <form asp-controller="Account" asp-action="UpdateUser" method="post">
            <input type="hidden" asp-for="@Model.Id" />

            <div class="mb-6">
                <label class="inline-flex items-center">
                    <input asp-for="@Model.TwoFactorEnabled" class="rounded border-gray-300 text-blue-600 shadow-sm focus:border-blue-300 focus: ring-blue-200 focus: ring-opacity-50" 
                    type="checkbox" id="twoFactorAuth" />
                    <span class="m-lg-2 text-gray-700" for="twoFactorAuth">
                        Использовать двухфакторную аутентификацию
                    </span>
                </label>
            </div>
            <div class="space-y-4">
                <a class="block w-full bg-gray-600 hover:bg-gray-700 text-white font-semibold py-2 px-4 rounded-md text-center transition duration-200" 
                    asp-controller="Account" asp-action="ForgotPassword">
                    Сброс пароля
                </a>
                <div class="flex justify-center gap-4">
                    <button type="submit" class="w-64 bg-blue-600 hover:bg-blue-700 text-white font-semibold py-2 px-4 rounded-md transition duration-200">
                        Сохранить
                    </button>

                    <a class="w-64 bg-gray-200 hover:bg-gray-300 text-gray-700 font-semibold py-2 px-4 rounded-md text-center transition duration-200"
                        asp-controller="Home" asp-action="Index">
                        На главную
                    </a>
                </div>
            </div>
        </form>
    </div>
</div>