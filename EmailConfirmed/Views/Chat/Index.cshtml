@model IEnumerable<ChatMessage>
@{
    @Html.AntiForgeryToken()
}

<!-- Добавляем Font Awesome -->
<link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" rel="stylesheet">

<div class="container mx-auto px-4 py-8 max-w-4xl">
    <!-- Заголовок -->
    <div class="mb-6 text-center">
        <h2 class="text-2xl font-bold text-gray-800">💬 Страница чата</h2>
    </div>

    <!-- Контейнер чата -->
    <div class="bg-white rounded-lg shadow-lg overflow-hidden">
        <!-- Область сообщений -->
        <div id="messagesContainer" class="h-[400px] overflow-y-auto p-4 bg-gray-50">
            <div class="space-y-2">
                <h5 class="text-gray-600 font-medium mb-3">Сообщения:</h5>
                <ul id="messagesList" class="space-y-3">
                    @foreach (var message in Model)
                    {
                        var isCurrentUser = message.User == User.Identity.Name;
                        <li class="@(isCurrentUser ? "flex justify-end" : "flex justify-start") mb-3">
                            <div class="flex items-start space-x-2 max-w-[80%]">
                                @if (!isCurrentUser)
                                {
                                    <div class="flex-shrink-0 w-8 h-8 rounded-full bg-gray-100 flex items-center justify-center">
                                        <i class="fas fa-user text-gray-500"></i>
                                    </div>
                                }
                                <div class="@(isCurrentUser ? "bg-blue-100" : "bg-gray-100") text-gray-800 rounded-lg py-2 px-4 break-words">
                                    @if (!isCurrentUser)
                                    {
                                        <p class="text-xs text-gray-600 mb-1">@message.User</p>
                                    }
                                    <p class="text-sm">@message.Text</p>
                                    <div class="@(isCurrentUser ? "flex items-center justify-end" : "") mt-1">
                                        <span class="text-xs text-gray-500">@message.DepartTime.ToLocalTime().ToString("HH:mm")</span>
                                        @if (isCurrentUser)
                                        {
                                            <i class="fas fa-check ml-1 text-blue-500"></i>
                                        }
                                    </div>
                                </div>
                                @if (isCurrentUser)
                                {
                                    <div class="flex-shrink-0 w-8 h-8 rounded-full bg-blue-100 flex items-center justify-center">
                                        <i class="fas fa-user text-blue-500"></i>
                                    </div>
                                }
                            </div>
                        </li>
                    }
                </ul>
            </div>
        </div>

        <!-- Информация о пользователе -->
        <div class="bg-gray-50 px-4 py-2 border-t border-gray-200">
            <div id="userInput" class="text-sm text-gray-600 flex items-center">
                <i class="fas fa-user-circle mr-2"></i>
                <span>@User?.Identity?.Name</span>
            </div>
        </div>

        <!-- Форма Отправки -->
        <div class="p-4 bg-white border-t border-gray-200">
            <div class="flex items-center space-x-4">
                <div class="flex-grow relative">
                    <input type="text"
                           id="messageInput"
                           class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-green-500 focus:border-green-500 transition-colors duration-200"
                           placeholder="Введите сообщение здесь..." />
                </div>
                <div class="flex-shrink-0">
                    <button id="sendButton"
                            class="px-6 py-2 bg-blue-600 hover:bg-blue-700 text-white rounded-lg transition-all duration-200 flex items-center space-x-2 disabled:opacity-50 disabled:cursor-not-allowed">
                        <i class="fas fa-paper-plane"></i>
                        <span class="ml-2">Отправить</span>
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Подключаем скрипты -->
<script src="~/js/signalr/dist/browser/signalr.js"></script>
<script src="~/js/chat.js"></script>

<style>
    /* Стилизация скроллбара */
    #messagesContainer::-webkit-scrollbar {
        width: 6px;
    }

    #messagesContainer::-webkit-scrollbar-track {
        background: #f1f1f1;
        border-radius: 3px;
    }

    #messagesContainer::-webkit-scrollbar-thumb {
        background: #888;
        border-radius: 3px;
    }

        #messagesContainer::-webkit-scrollbar-thumb:hover {
            background: #666;
        }

    /* Добавляем базовые стили для сообщений */
    #messagesList {
        list-style: none;
        padding: 0;
    }

        #messagesList li {
            margin-bottom: 1rem;
        }
</style>
