@model RoleEdit
@{
    ViewData["Title"] = "Update Role";
}

<div class="container mx-auto px-4 py-8">
    <div class="max-w-4xl mx-auto">
        <h1 class="text-3xl font-bold mb-6 text-gray-800">Изменение роли</h1>
        <div asp-validation-summary="All" class="mb-6 text-sm text-red-600"></div>

        <form method="post" class="space-y-8">
            <input type="hidden" name="roleName" value="@Model.Role.Name" />
            <input type="hidden" name="roleId" value="@Model.Role.Id" />

            <!-- Добавление пользователей -->
            <div class="bg-white rounded-lg shadow-lg p-6">
                <h2 class="text-xl font-semibold mb-4 text-green-600">Добавить к роли "@Model.Role.Name"</h2>
                <div class="overflow-x-auto">
                    <table class="min-w-full divide-y divide-gray-200">
                        @if (Model.NonMembers.Count() == 0)
                        {
                            <tr>
                                <td colspan="2" class="px-6 py-4 text-sm text-gray-500 text-center">
                                    Все пользователи являются участниками данной роли
                                </td>
                            </tr>
                        }
                        else
                        {
                            @foreach (User user in Model.NonMembers.ToList())
                            {
                                <tr class="hover:bg-gray-50">
                                    <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-700">
                                        @user.UserName
                                    </td>
                                    <td class="px-6 py-4 whitespace-nowrap">
                                        <input type="checkbox" name="AddIds" value="@user.Id"
                                               class="h-4 w-4 text-green-600 focus:ring-green-500 border-gray-300 rounded" />
                                    </td>
                                </tr>
                            }
                        }
                    </table>
                </div>
            </div>

            <!-- Удаление пользователей -->
            <div class="bg-white rounded-lg shadow-lg p-6">
                <h2 class="text-xl font-semibold mb-4 text-red-600">Удалить из роли "@Model.Role.Name"</h2>
                <div class="overflow-x-auto">
                    <table class="min-w-full divide-y divide-gray-200">
                        @if (Model.Members.Count() == 0)
                        {
                            <tr>
                                <td colspan="2" class="px-6 py-4 text-sm text-gray-500 text-center">
                                    Ни один пользователь не является участником данной роли
                                </td>
                            </tr>
                        }
                        else
                        {
                            @foreach (User user in Model.Members.ToList())
                            {
                                <tr class="hover:bg-gray-50">
                                    <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-700">
                                        @user.UserName
                                    </td>
                                    <td class="px-6 py-4 whitespace-nowrap">
                                        <input type="checkbox" name="DeleteIds" value="@user.Id"
                                               class="h-4 w-4 text-red-600 focus:ring-red-500 border-gray-300 rounded" />
                                    </td>
                                </tr>
                            }
                        }
                    </table>
                </div>
            </div>

            <div class="flex items-center space-x-4">
                <button type="submit" class="inline-flex items-center px-4 py-2 bg-green-600 hover:bg-green-700 text-white font-medium rounded-md transition-colors duration-300">
                    <i class="fas fa-save mr-2"></i>
                    Сохранить
                </button>
                <a asp-action="Index" class="inline-flex items-center px-4 py-2 bg-gray-600 hover:bg-gray-700 text-white font-medium rounded-md transition-colors duration-300">
                    <i class="fas fa-arrow-left mr-2"></i>
                    Назад
                </a>
            </div>
        </form>
    </div>
</div>
