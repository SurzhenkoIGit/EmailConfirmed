@model IEnumerable<System.Security.Claims.Claim>
@{
    ViewData["Title"] = "Claims";
}

<div class="container mx-auto px-4 py-8">
    <h1 class="text-3xl font-bold mb-6 text-gray-800">Утверждения</h1>

    <div class="mb-6">
        <a asp-action="Create"
           class="inline-flex items-center px-4 py-2 bg-green-600 hover:bg-green-700 text-white font-medium rounded-md transition-colors duration-300">
            <i class="fas fa-plus mr-2"></i>
            Создать утверждение
        </a>
    </div>

    <div class="overflow-x-auto bg-white rounded-lg shadow">
        <table class="min-w-full divide-y divide-gray-200">
            <thead class="bg-gray-50">
                <tr>
                    <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Subject</th>
                    <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Issuer</th>
                    <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Type</th>
                    <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Value</th>
                    <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Действия</th>
                </tr>
            </thead>
            <tbody class="bg-white divide-y divide-gray-200">
                @foreach (var claim in Model.OrderBy(x => x.Type))
                {
                    <tr class="hover:bg-gray-50">
                        <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-700">@claim.Subject.Name</td>
                        <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-700">@claim.Issuer</td>
                        <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-700">@claim.Type</td>
                        <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-700">@claim.Value</td>
                        <td class="px-6 py-4 whitespace-nowrap text-sm">
                            <form asp-action="Delete" method="post" class="inline">
                                <input type="hidden" name="claimValues" value="@claim.Type; @claim.Value; @claim.Issuer" />
                                <button type="submit"
                                        class="inline-flex items-center px-3 py-1 bg-red-600 hover:bg-red-700 text-white text-sm font-medium rounded-md transition-colors duration-300">
                                    <i class="fas fa-trash-alt mr-2"></i>
                                    Удалить
                                </button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>