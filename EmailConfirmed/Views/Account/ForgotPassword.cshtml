@model ForgotPasswordViewModel
@{
    ViewData["Title"] = "Забыли пароль?";
}

<div class="container mx-auto px-4 py-8 max-w-md">
    <div class="bg-white rounded-lg shadow-md p-6">

        <div class="mb-6 text-center">
            <h1 class="text-2xl font-bold text-gray-800">Сброс пароля</h1>
        </div>
        <div class="mb-4">
            <div class="text-red-500 text-sm" asp-validation-summary="All" ></div>
        </div>

        <form asp-controller="Account" asp-action="ForgotPassword" method="post">
                
            <div class="mb-6">
                <label asp-for="Email" class="blockquote text-sm-center font-medium text-gray-700 mb-2">Ваш Email</label>
                    <input asp-for="Email" class="w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm focus:ring-blue-500 focus:border-blue-500" 
                    placeholder="Введите Email"/>
            </div>
            <button class="w-full bg-blue-600 hover:bg-blue-700 text-white font-semibold py-2 px-4 rounded-md transition-all duration-200"
                    type="submit">
                Сброс пароля
            </button>
        </form>
    </div>
</div>
