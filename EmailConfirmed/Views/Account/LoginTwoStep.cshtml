@using EmailConfirmed.Models
@model TwoFactor

@{
    ViewData["Title"] = "Login Two Step";
}

<div class="container mx-auto px-4 py-8 max-w-md">
        <div class="bg-white rounded-lg shadow-md p-6">
            <div class="mb-6 text-center">
                <h1 class="text-2xl font-bold text-gray-800">Двухфакторная аутентификация</h1>
            </div>
        <div class="mb-4"> 
            <div class="text-red-500 text-sm" asp-validation-summary="All"></div>
        </div>

        <div class="mb-6 bg-blue-50 p-4 rounded-lg">
            <p class="text-blue-800 font-medium mb-2">Введите ваш код подтверждения</p>
            <p class="text-blue-600 text-sm">Код отправлен на email, указанный при регистрации</p>
        </div>

        <form asp-action="LoginTwoStep" method="post">
            <input type="hidden" asp-for="@Model.ReturnUrl" />

            <div class="mb-6">
                <label for="twoFactorCode" class="blockquote text-sm-center font-medium text-gray-700 mb-2">Код</label>
                <input asp-for="@Model.TwoFactorCode" 
                class="w-full px-3 py-2 border border-gray-300 rounded-md shadowsmall focus:ring-blue-500 focus:border-blue-500" 
                placeholder="Введите код подтверждения"/>
            </div>
            <button class="w-full bg-blue-600 hover:bg-blue-700 text-white font-semibold py-2 px-4 rounded-md transition-all duration-200" 
                    type="submit">Отправить код
            </button>
        </form>
    </div>
</div>
